# Crie um projeto gratuito em https://supabase.com, rode o arquivo
# supabase/migrations/20261007120000_inicial.sql no SQL Editor dele e copie as chaves
# em Project Settings > API Keys (a "publishable"/"anon" key — é pública, pode ir no site).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-publica-aqui
